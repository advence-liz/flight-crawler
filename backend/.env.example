# 应用配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_TYPE=sqlite
DB_DATABASE=./data/flight-crawler.db

# 爬虫配置
# 设为 false 可禁用爬虫（线上环境推荐，无需安装 puppeteer）
CRAWLER_ENABLED=true
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT=30000
CRAWLER_MAX_RETRIES=3
# 自动爬取定时任务开关（默认关闭，本地需要自动爬取时设为 true）
CRAWLER_AUTO_CRAWL=false

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 管理员 Token（用于保护写操作接口）
# 未配置时所有接口放行（本地开发友好）
# 生产环境请设置为随机强密码
ADMIN_TOKEN=your-secret-token-here

# AI 行程规划：默认关闭。模型仅处理用户输入的旅行需求，不接收航班库。
# 在进程环境或平台密钥管理中注入 DEEPSEEK_API_KEY；生产环境还必须配置 ADMIN_TOKEN。
TRIP_AI_ENABLED=false
# 生产只允许官方 deepseek-flash；OpenAI 兼容网关仅供开发/测试，不计入正式账本。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 全站每天限额（人民币元），北京时间零点重置。未设置默认 5，支持两位小数；0 停止模型调用。
TRIP_AI_DAILY_LIMIT_CNY=5
# 官方 API 必须在进程环境或平台密钥管理中注入 TRIP_AI_BUDGET_DATABASE_URL。
# 使用持久 PostgreSQL，需可建表；不要复用会被替换的航班 SQLite。未配置时不调用模型。

# 只读航班 MCP (/api/mcp)，默认关闭，不走模型或 AI 账本。
# 管理员在「用户管理」为受邀用户发放独立 MCP Token；不再使用后端共享 Token。
# 用户管理要求 ADMIN_TOKEN（开发环境也不例外），MCP 尚未开放时也可准备邀请名单。
# 注入持久 PostgreSQL 的 FLIGHT_MCP_QUOTA_DATABASE_URL，保存用户、凭据哈希和用量；需可建表。
# 全站每日 MCP 工具请求数，按北京时间零点重置；0 禁止工具调用。不影响站内查询。
FLIGHT_MCP_ENABLED=false
FLIGHT_MCP_DAILY_LIMIT=100

# 网站账号：默认关闭。生产环境必须为 HTTPS，并将前端与 /api/auth、/api/account
# 及 /api/routes/ai-trip/chat 映射在同一对外 origin；SQLite 不保存网站账号。
SITE_AUTH_ENABLED=false
# SITE_AUTH_ORIGIN=http://localhost:8899
# SITE_AUTH_SECRET：用密码管理器生成至少 32 字符，经平台密钥注入。
# OAuth 回调：<SITE_AUTH_ORIGIN>/api/auth/callback/github 或 /api/auth/callback/google。
# SITE_AUTH_GITHUB_CLIENT_ID / SITE_AUTH_GITHUB_CLIENT_SECRET
# SITE_AUTH_GOOGLE_CLIENT_ID / SITE_AUTH_GOOGLE_CLIENT_SECRET
# SITE_AUTH_RESEND_API_KEY / SITE_AUTH_EMAIL_FROM（发件域须在 Resend 验证）
# 默认/最多 80 封/北京时间日，仅发给受邀邮箱；0 关闭邮件发送。
SITE_AUTH_EMAIL_DAILY_LIMIT=80
