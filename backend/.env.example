# 应用配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_TYPE=sqlite
DB_DATABASE=./data/flight-crawler.db

# 爬虫配置
# 设为 false 可禁用爬虫（线上环境推荐，无需安装 puppeteer）
CRAWLER_ENABLED=true
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT=30000
CRAWLER_MAX_RETRIES=3
# 自动爬取定时任务开关（默认关闭，本地需要自动爬取时设为 true）
CRAWLER_AUTO_CRAWL=false

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 管理员 Token（用于保护写操作接口）
# 未配置时所有接口放行（本地开发友好）
# 生产环境请设置为随机强密码
ADMIN_TOKEN=your-secret-token-here

# AI 行程规划：默认关闭。模型仅处理用户输入的旅行需求，不接收航班库。
# 在进程环境或平台密钥管理中注入 DEEPSEEK_API_KEY；生产环境还必须配置 ADMIN_TOKEN。
TRIP_AI_ENABLED=false
# 官方 DeepSeek API 默认值；OpenAI 兼容网关可覆盖 URL 和模型名。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
